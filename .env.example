# Copy this file to .env and fill in the values. Never commit .env.

# API-Football key (https://dashboard.api-football.com/ — free plan: 100 requests/day)
API_FOOTBALL_KEY=your_api_football_key_here

# Fernet key used by Airflow to encrypt connections. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Linux/macOS: output of `id -u` (e.g. 501 on macOS). Windows: 50000.
AIRFLOW_UID=50000
